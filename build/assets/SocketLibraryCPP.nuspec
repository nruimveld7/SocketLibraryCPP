<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SocketLibraryCPP</id>
    <version>1.2.5</version>
    <authors>Noah Ruimveld</authors>
    <owners>Noah Ruimveld</owners>
    <description>Windows static C++ socket library (WinSock2). Ready-to-use TCP/UDP client &amp; server classes with async callbacks, fixed-length TCP framing, and automatic MSBuild integration (x86/x64, Debug/Release).</description>
    <readme>docs\README.md</readme>
    <projectUrl>https://github.com/nruimveld7/SocketLibraryCPP</projectUrl>
    <repository type="git" url="https://github.com/nruimveld7/SocketLibraryCPP.git" />
    <license type="file">LICENSE</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>SocketLibraryCPP.png</icon>
    <releaseNotes>
      - 1.2.5: Add explicit Windows.h include where winsock2 is included (WinSock2First.h)
      - 1.2.4: Fix rogue Windows.h include
      - 1.2.3: Fix runtime library support build issues
      - 1.2.2: Support more common runtime library settings
      - 1.2.1: API cleanup, lifecycle refactoring, centralized TCP Server socket connections
      - 1.2.0: API cleanup, TCP socket refactoring, normalized destruction
      - 1.1.2: Update to NuGet package docs
      - 1.1.1: API cleanup, better errors, string overloads
    </releaseNotes>
    <tags>c++;cpp;winsock;winsock2;tcp;udp;socket;networking;server;client;windows;msvc;static-lib;library</tags>
  </metadata>
  <files>
    <file src="include\**\*.*" target="build\native\include" />
    <file src="build\native\SocketLibraryCPP.props" target="build\native\SocketLibraryCPP.props" />
    <file src="build\native\SocketLibraryCPP.targets" target="build\native\SocketLibraryCPP.targets" />
    <file src="lib\SocketLibraryCPP\**\SocketLibraryCPP.lib" target="build\native\lib\" />
    <file src="lib\SocketLibraryCPP\**\*.pdb" target="build\native\lib\" />
    <file src="build\assets\README.md" target="docs\README.md" />
    <file src="build\assets\LICENSE" target="LICENSE" />
    <file src="build\assets\SocketLibraryCPP.png" target="SocketLibraryCPP.png" />
  </files>
</package>
